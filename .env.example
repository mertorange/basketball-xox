# Copy to .env and fill in. docker compose reads it automatically.

# Secret for POST /admin/reload, which the data refresh calls. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
HOOPGRID_ADMIN_TOKEN=

# Public host name; Caddy gets an HTTPS certificate for it (server profile only)
HOOPGRID_DOMAIN=hoopgrid.example.com

# Other sites allowed to call the API (comma separated); the game itself needs none
HOOPGRID_ALLOWED_ORIGINS=https://hoopgrid.example.com

# Host port for the app (bound to 127.0.0.1)
HOOPGRID_PORT=8000
