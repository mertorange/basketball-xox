# HTTPS in front of the game server. Caddy gets the certificate on its own and passes
# WebSocket upgrades through, so /ws/rooms/... needs nothing extra.
{$HOOPGRID_DOMAIN} {
	encode zstd gzip
	request_body {
		max_size 64KB
	}
	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
	}
	# The data refresh and the health check reach the app directly, inside Docker
	@internal path /admin/* /health
	handle @internal {
		respond 404
	}
	handle {
		reverse_proxy app:8000
	}
}
